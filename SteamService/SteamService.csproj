<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockMode>LockModeFilePathAndContent</NuGetLockMode>
    <AssemblyName>SteamService</AssemblyName>
    <RootNamespace>SteamService</RootNamespace>
    <Product>MyWallpaperX</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Probe/**/*.cs;*SelfTest.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SteamKit2" Version="3.5.0" />
    <Content Include="NOTICE.md;licenses/**/*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
