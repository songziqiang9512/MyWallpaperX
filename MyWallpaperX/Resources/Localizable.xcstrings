          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт личных настроек не завершён (%@). Данные для восстановления сохранены, поэтому пока нельзя упорядочивать библиотеку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Import der persönlichen Einstellungen wurde nicht abgeschlossen (%@). Wiederherstellungsdaten bleiben erhalten; die Bibliothek kann derzeit nicht organisiert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importation des réglages personnels n’est pas terminée (%@). Les données de restauration sont conservées ; impossible d’organiser la bibliothèque pour l’instant."
          }
        }
      }
    },
