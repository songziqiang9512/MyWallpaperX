    },
    "The screen saver only supports local videos. Choose a different file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen saver only supports local videos. Choose a different file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏保仅支持本地视频，请重新选择。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заставка поддерживает только локальные видео. Выберите другой файл."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirmschoner unterstützt nur lokale Videos. Bitte eine andere Datei auswählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’économiseur d’écran ne prend en charge que les vidéos locales. Choisissez un autre fichier."
          }
        }
      }
    },
    "The screen saver start time must be earlier than the display-off time. Desktop wallpaper stays as is.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen saver start time must be earlier than the display-off time. Desktop wallpaper stays as is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏保开始时间应早于熄屏时间，桌面墙纸保持原样。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время запуска заставки должно быть раньше времени отключения экрана. Обои рабочего стола не изменятся."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Startzeit des Bildschirmschoners muss vor dem Ausschalten des Displays liegen. Das Desktop-Wallpaper bleibt unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure de démarrage de l’économiseur d’écran doit précéder l’extinction de l’écran. Le fond d’écran du bureau reste inchangé."
          }
        }
      }
    },
    "The selected file couldn’t be added to the library; the original link is unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected file couldn’t be added to the library; the original link is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
