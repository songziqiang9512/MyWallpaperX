    "You can browse safe content anonymously. Enter your own API key to browse with your account’s permissions; the key is stored in the system keychain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can browse safe content anonymously. Enter your own API key to browse with your account’s permissions; the key is stored in the system keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名即可浏览安全内容。填写自己的 API Key 后可按账号权限浏览；Key 保存在系统钥匙串中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без входа можно просматривать безопасный контент. Укажите свой API-ключ, чтобы просматривать с учётом прав аккаунта; ключ хранится в системном связке ключей."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Inhalte lassen sich anonym durchsuchen. Mit Ihrem eigenen API-Key durchsuchen Sie Inhalte mit den Berechtigungen Ihres Kontos; der Key wird im Systemschlüsselbund gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez parcourir le contenu sûr en mode anonyme. Saisissez votre propre clé API pour parcourir selon les droits de votre compte ; la clé est conservée dans le trousseau du système."
          }
        }
      }
    },
    "Your local files won’t be deleted and playback won’t be interrupted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your local files won’t be deleted and playback won’t be interrupted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会删除本地文件或中断播放"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные файлы не будут удалены, воспроизведение не прервётся"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Dateien werden nicht gelöscht und die Wiedergabe wird nicht unterbrochen"
