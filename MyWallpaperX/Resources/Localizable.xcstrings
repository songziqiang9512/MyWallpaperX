    "“%@” image or video couldn’t be updated; your previous selection was kept. Choose a readable PNG/JPEG image or MP4/MOV/M4V video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ konnte nicht als Bild oder Video aktualisiert werden; die bisherige Auswahl bleibt erhalten. Wählen Sie ein lesbares PNG/JPEG-Bild oder ein MP4/MOV/M4V-Video."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” image or video couldn’t be updated; your previous selection was kept. Choose a readable PNG/JPEG image or MP4/MOV/M4V video."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de mettre à jour l’image ou la vidéo « %@ » ; votre sélection précédente a été conservée. Choisissez une image PNG/JPEG lisible ou une vidéo MP4/MOV/M4V."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось обновить изображение или видео «%@»; прежний выбор сохранён. Выберите доступное изображение PNG/JPEG или видео MP4/MOV/M4V."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”图像或视频无法更新，已保留原选择。请选择可读取的 PNG/JPEG 图像或 MP4/MOV/M4V 视频。"
          }
        }
      }
    },
