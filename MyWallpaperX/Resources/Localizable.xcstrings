    "\n%lld more not shown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n%lld more not shown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n另有 %lld 项未显示"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\nЕщё %lld не показано"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n%lld weitere nicht angezeigt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n%lld autres non affichés"
          }
        }
      }
    },
    "\nImported content and the existing list are both kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nImported content and the existing list are both kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n已入库内容和原列表均保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\nИмпортированное содержимое и существующий список сохраняются."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\nImportierte Inhalte und die vorhandene Liste bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nLe contenu importé et la liste existante sont tous deux conservés."
          }
        }
      }
    },
    "\nOriginal wallpapers that were imported successfully remain in your library.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nOriginal wallpapers that were imported successfully remain in your library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n已成功导入的原始壁纸仍保留在资料库中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\nИсходные обои, успешно импортированные, остаются в библиотеке."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\nErfolgreich importierte originale Wallpaper bleiben in deiner Mediathek."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nLes fonds d’écran d’origine importés avec succès restent dans votre bibliothèque."
          }
        }
      }
    },
    "\nPlease try quitting again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nPlease try quitting again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n请重试退出。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\nПовторите попытку выхода."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\nBitte versuche erneut zu beenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nVeuillez réessayer de quitter."
          }
        }
      }
    },
    "\nReason: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nReason: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n原因：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\nПричина: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\nGrund: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nRaison : %@"
          }
        }
      }
    },
    "\nThe saved screen saver copy is kept; you can remove it in Lock Screen & Screen Saver.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nThe saved screen saver copy is kept; you can remove it in Lock Screen & Screen Saver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n已保存的屏保副本会保留，可在「锁屏与屏保」中清除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\nСохранённая копия для хранителя экрана останется; её можно удалить в разделе «Экран блокировки и хранитель экрана»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\nDie gespeicherte Bildschirmschonerkopie bleibt erhalten; sie lässt sich unter „Sperrbildschirm & Bildschirmschoner“ löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nLa copie enregistrée pour l’économiseur d’écran est conservée ; vous pouvez la supprimer dans « Verrouillage et économiseur d’écran »."
          }
        }
      }
    },
    " %lld more items are temporarily unavailable (%@); refresh to retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " %lld more items are temporarily unavailable (%@); refresh to retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 另有 %lld 项暂不可用（%@），可刷新重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Ещё %lld элементов временно недоступны (%@); обновите и повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " %lld weitere Elemente sind vorübergehend nicht verfügbar (%@); aktualisieren Sie, um es erneut zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " %lld autres éléments sont temporairement indisponibles (%@) ; actualisez pour réessayer."
          }
        }
      }
    },
    " Automatic restore has been disabled, but Keychain cleanup failed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Automatic restore has been disabled, but Keychain cleanup failed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 已禁止自动恢复，但 Keychain 清理失败。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Автовосстановление отключено, но очистить связку ключей не удалось."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Die automatische Wiederherstellung wurde deaktiviert, aber die Bereinigung des Schlüsselbunds ist fehlgeschlagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " La restauration automatique a été désactivée, mais le nettoyage du trousseau a échoué."
          }
        }
      }
    },
    " Copy": {
      "localizations": {
        "en": {
          "stringUnit": {
