          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les adresses HTTP et HTTPS sont prises en charge ; les commandes et autres protocoles ne le sont pas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживаются только адреса HTTP и HTTPS; команды и другие протоколы не поддерживаются."
