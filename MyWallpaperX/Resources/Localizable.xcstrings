    "3  Set when the screen saver starts, then click “Done”. You don’t need to change the desktop wallpaper." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3  Legen Sie fest, wann der Bildschirmschoner startet, und klicken Sie auf „Fertig“. Das Wallpaper auf dem Schreibtisch muss nicht geändert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3  Set when the screen saver starts, then click “Done”. You don’t need to change the desktop wallpaper."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3  Définissez le délai de démarrage de l’économiseur d’écran, puis cliquez sur « Terminé ». Inutile de modifier le fond d’écran du bureau."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3  Задайте время запуска экранной заставки и нажмите «Готово». Обои рабочего стола менять не нужно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3  设置屏保开始时间，再点“完成”。无需更改桌面墙纸。"
          }
        }
