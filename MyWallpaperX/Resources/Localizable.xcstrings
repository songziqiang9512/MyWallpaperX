    },
    "\nThe saved screen saver copy is kept; you can remove it in Lock Screen & Screen Saver." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDie gespeicherte Bildschirmschonerkopie bleibt erhalten; sie lässt sich unter „Sperrbildschirm & Bildschirmschoner“ löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nThe saved screen saver copy is kept; you can remove it in Lock Screen & Screen Saver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLa copie enregistrée pour l’économiseur d’écran est conservée ; vous pouvez la supprimer dans « Verrouillage et économiseur d’écran »."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nСохранённая копия для хранителя экрана останется; её можно удалить в разделе «Экран блокировки и хранитель экрана»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n已保存的屏保副本会保留，可在「锁屏与屏保」中清除。"
          }
        }
      }
    },
