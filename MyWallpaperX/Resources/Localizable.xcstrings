    },
    "The saved playback source has an unknown version or is damaged. The original data was kept; select a wallpaper manually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved playback source has an unknown version or is damaged. The original data was kept; select a wallpaper manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的播放来源版本未知或已损坏，已保留原数据；请手动选择壁纸。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У сохранённого источника воспроизведения неизвестная версия или он повреждён. Исходные данные сохранены; выберите обои вручную."
          }
