    },
    "The saved login doesn’t match the actual account, so restoring stopped. Sign in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved login doesn’t match the actual account, so restoring stopped. Sign in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
