          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённый вход не совпадает с текущей учётной записью, восстановление остановлено. Войдите снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
