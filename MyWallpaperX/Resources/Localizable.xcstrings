    },
    "The source file isn't in the current Downloads folder, or it's playing or being prepared. Stop it first, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source file isn't in the current Downloads folder, or it's playing or being prepared. Stop it first, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源文件不属于当前下载目录，或正在播放/准备；请先停止后重试"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный файл не относится к текущей папке загрузок либо воспроизводится или готовится. Сначала остановите его и повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelldatei gehört nicht zum aktuellen Downloads-Ordner oder wird gerade abgespielt bzw. vorbereitet. Beenden Sie sie zuerst und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier source n’appartient pas au dossier Téléchargements actuel, ou il est en cours de lecture ou de préparation. Arrêtez-le d’abord, puis réessayez."
          }
        }
      }
    },
    "The source file was deleted, but the app could not save the removal record. Other references will show the file as missing.\n": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source file was deleted, but the app could not save the removal record. Other references will show the file as missing.\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源文件已删除，但 App 移除记录未能保存。其他关系将显示文件缺失。\n"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный файл удалён, но приложение не смогло сохранить запись об удалении. В других местах файл будет отображаться отсутствующим.\n"
