    "Follow mode will stop and the published video will be cleared. Change the system wallpaper and screen saver in System Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow mode will stop and the published video will be cleared. Change the system wallpaper and screen saver in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将停止跟随并清除已发布视频。系统的墙纸与屏保选择请在系统设置中调整。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживание будет остановлено, опубликованное видео удалено. Обои и заставку системы меняйте в «Системных настройках»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modus „Folgen“ wird beendet und das veröffentlichte Video entfernt. System-Wallpaper und Bildschirmschoner in den Systemeinstellungen ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi va s’arrêter et la vidéo publiée sera effacée. Modifiez le fond d’écran et l’économiseur d’écran système dans Réglages Système."
          }
        }
      }
    },
