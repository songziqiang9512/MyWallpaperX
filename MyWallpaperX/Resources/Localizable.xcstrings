    "Not enough disk space. The download staging data has been kept; free up space and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough disk space. The download staging data has been kept; free up space and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘空间不足，下载暂存已保留；释放空间后可重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно места на диске. Временные данные загрузки сохранены; освободите место и повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genügend Speicherplatz. Die Download-Zwischendaten wurden behalten; schaffen Sie Platz und versuchen Sie es erneut."
