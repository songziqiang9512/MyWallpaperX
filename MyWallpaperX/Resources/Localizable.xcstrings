          "stringUnit": {
            "state": "translated",
            "value": "Settings changed after the import, so the old set can’t overwrite them. Keep the recovery file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏好已在导入后发生变化，不能用旧配置覆盖，请保留恢复文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки изменились после импорта, старые данные не должны их перезаписывать. Сохраните файл восстановления."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen haben sich nach dem Import geändert und dürfen nicht durch die alten überschrieben werden. Behalten Sie die Wiederherstellungsdatei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les préférences ont changé après l’importation ; les anciens réglages ne peuvent pas les écraser. Conservez le fichier de restauration."
          }
        }
      }
    },
