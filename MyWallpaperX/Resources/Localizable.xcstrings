    "Wallhaven didn’t preserve the random paging seed, so paging stopped. Refresh to get a new batch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallhaven didn’t preserve the random paging seed, so paging stopped. Refresh to get a new batch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallhaven 未保持随机分页种子，已停止连续翻页；请刷新获取新一批。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallhaven не сохранил начальное значение случайной пагинации, поэтому переход по страницам остановлен. Обновите, чтобы получить новую партию."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallhaven hat den Seed für die zufällige Seitennavigation nicht beibehalten; das Weiterblättern wurde beendet. Aktualisieren Sie, um eine neue Auswahl zu erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallhaven n’a pas conservé la graine de pagination aléatoire ; la pagination s’est arrêtée. Actualisez pour obtenir une nouvelle sélection."
          }
        }
      }
    },
