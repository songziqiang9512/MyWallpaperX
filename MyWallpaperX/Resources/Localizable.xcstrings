    "Downloads in progress and queued will be stopped. Downloaded files and the current wallpaper aren’t affected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads in progress and queued will be stopped. Downloaded files and the current wallpaper aren’t affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进行中和排队中的下载任务将被停止；已下载的文件和当前壁纸不受影响。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняющиеся и стоящие в очереди загрузки будут остановлены; уже загруженные файлы и текущие обои не пострадают."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufende und anstehende Downloads werden gestoppt; bereits geladene Dateien und das aktuelle Wallpaper sind nicht betroffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements en cours et en attente seront arrêtés ; les fichiers déjà téléchargés et le fond d’écran actuel ne sont pas affectés."
          }
        }
      }
    },
