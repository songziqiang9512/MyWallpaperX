    },
    "This is a dependent Web preset shell. Its base dependency host %@ is missing, so it can’t play right now.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a dependent Web preset shell. Its base dependency host %@ is missing, so it can’t play right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是依赖型 WEB 预设壳，当前缺少基础依赖宿主 %@，因此暂时无法播放。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это зависимая оболочка веб-пресета. Базовый хост зависимости %@ отсутствует, поэтому воспроизведение сейчас невозможно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine abhängige Web-Preset-Hülle. Der benötigte Basis-Host %@ fehlt, daher ist die Wiedergabe derzeit nicht möglich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit d’une coque de preset Web dépendante. Son hôte de dépendance de base %@ est absent, la lecture est donc impossible pour le moment."
          }
        }
      }
    },
    "This item can’t be played right now.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item can’t be played right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前项目暂时不可播放。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот элемент сейчас нельзя воспроизвести."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Element kann derzeit nicht wiedergegeben werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément ne peut pas être lu pour le moment."
          }
        }
      }
    },
    "This item has a pending import transaction. Rescan, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item has a pending import transaction. Rescan, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目有待恢复的入库事务，请重新扫描后重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого элемента есть незавершённая транзакция импорта. Запустите повторное сканирование и повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Eintrag steht noch eine Importtransaktion aus. Führen Sie einen neuen Scan aus und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément a une transaction d’importation en attente. Relancez l’analyse, puis réessayez."
          }
        }
      }
    },
    "This item is restricted by the site's display permissions. Open the original site to check your settings.": {
      "localizations": {
        "en": {
