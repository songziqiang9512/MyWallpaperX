        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur HTTP- und HTTPS-URLs werden unterstützt. Befehle und andere Protokolle werden nicht unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les adresses HTTP et HTTPS sont prises en charge ; les commandes et autres protocoles ne le sont pas."
          }
        }
      }
    },
    "Only confirmed regular source files can be deleted; folders and symbolic links can’t": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only confirmed regular source files can be deleted; folders and symbolic links can’t"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅能删除确认的普通源文件，不能删除目录或符号链接"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалять можно только подтверждённые обычные исходные файлы, но не каталоги и символические ссылки"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur bestätigte reguläre Quelldateien können gelöscht werden, keine Ordner oder symbolischen Links"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les fichiers source ordinaires confirmés peuvent être supprimés, pas les dossiers ni les liens symboliques"
          }
        }
      }
    },
    "Only downloaded or locally available wallpapers can be added.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only downloaded or locally available wallpapers can be added."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅可添加已下载或本地可用的壁纸。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно добавлять только скачанные или доступные локально обои."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es können nur heruntergeladene oder lokal verfügbare Wallpaper hinzugefügt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les fonds d’écran téléchargés ou disponibles localement peuvent être ajoutés."
          }
        }
      }
    },
    "Only images are imported from folders; select videos as individual files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only images are imported from folders; select videos as individual files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹仅递归导入图片；视频请直接选择文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из папок импортируются только изображения; выбирайте видео как отдельные файлы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Ordnern werden nur Bilder importiert; wählen Sie Videos als einzelne Dateien aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les images sont importées depuis les dossiers ; sélectionnez les vidéos comme fichiers individuels."
          }
        }
      }
    },
    "Only local files, folders, or HTTP(S) URLs without account information are supported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only local files, folders, or HTTP(S) URLs without account information are supported"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持本机文件、目录或不含账户信息的 HTTP(S) 网址"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживаются только локальные файлы, каталоги или адреса HTTP(S) без данных учётной записи"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützt werden nur lokale Dateien, Ordner oder HTTP(S)-URLs ohne Kontoinformationen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les fichiers locaux, dossiers ou URL HTTP(S) sans informations de compte sont pris en charge"
          }
        }
      }
    },
    "Only managed version folders are reclaimed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only managed version folders are reclaimed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅回收受管版本目录。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освобождаются только каталоги управляемых версий."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur Verzeichnisse verwalteter Versionen freigegeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les dossiers de versions gérés sont libérés."
          }
        }
      }
    },
    "Only playback history is cleared. Original wallpapers, playlists and favorites are kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only playback history is cleared. Original wallpapers, playlists and favorites are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅清除播放记录。原始壁纸、播放列表和特别喜爱均会保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищается только история воспроизведения. Исходные обои, плейлисты и избранное сохраняются."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Wiedergabeverlauf wird gelöscht. Originale Wallpaper, Wiedergabelisten und Favoriten bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul l’historique de lecture est effacé. Les fonds d’écran d’origine, les listes et les favoris sont conservés."
          }
        }
      }
    },
    "Only the history will be cleared. Active tasks and downloaded files will be kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the history will be cleared. Active tasks and downloaded files will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只清除历史记录，保留活动任务和已下载文件"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистится только история; активные задачи и загруженные файлы сохранятся."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Verlauf wird gelöscht. Aktive Aufgaben und heruntergeladene Dateien bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul l’historique sera effacé. Les tâches actives et les fichiers téléchargés seront conservés."
          }
        }
      }
    },
    "Only the sign-in token is stored in the macOS keychain, never your password.": {
