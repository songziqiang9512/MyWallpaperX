        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conditional binding value can’t be resolved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条件绑定值无法解析。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось вычислить значение условной привязки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert der bedingten Bindung kann nicht aufgelöst werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur de la liaison conditionnelle ne peut pas être résolue."
          }
        }
      }
    },
    "The configured download folder can’t be resolved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The configured download folder can’t be resolved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置的下载目录无法解析。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настроенную папку загрузок не удаётся определить."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der konfigurierte Download-Ordner kann nicht aufgelöst werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de téléchargement configuré ne peut pas être résolu."
          }
        }
      }
    },
    "The configured downloads folder is inaccessible.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The configured downloads folder is inaccessible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置的下载目录无法访问。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настроенная папка загрузок недоступна."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den konfigurierten Download-Ordner kann nicht zugegriffen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de téléchargement configuré est inaccessible."
          }
        }
      }
    },
    "The connection to the Steam service was lost. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to the Steam service was lost. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 服务连接已中断，请重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение с сервисом Steam прервано. Повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zum Steam-Dienst wurde unterbrochen. Versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion au service Steam a été interrompue. Réessayez."
          }
        }
      }
    },
    "The content area isn’t ready yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content area isn’t ready yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容区域尚未就绪"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Область содержимого ещё не готова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhaltsbereich ist noch nicht bereit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La zone de contenu n’est pas encore prête."
          }
        }
      }
    },
    "The content state was saved, but cleaning up the download staging area failed. It will be retried later: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content state was saved, but cleaning up the download staging area failed. It will be retried later: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容状态已保存，但下载暂存清理失败，稍后将重试：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние содержимого сохранено, но очистка временных файлов загрузки не удалась. Повторим позже: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhaltsstatus wurde gesichert, aber das Aufräumen des Download-Zwischenspeichers ist fehlgeschlagen. Es wird später erneut versucht: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état du contenu a été enregistré, mais le nettoyage des fichiers temporaires de téléchargement a échoué. Une nouvelle tentative aura lieu plus tard : %@"
          }
        }
      }
    },
    "The content was added to the library, but the task record couldn’t be saved; it will be reconciled at the next launch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content was added to the library, but the task record couldn’t be saved; it will be reconciled at the next launch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容已入库；任务记录保存失败，下次启动将对账。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое добавлено в библиотеку, но запись задачи сохранить не удалось; сверка произойдёт при следующем запуске."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt wurde zur Bibliothek hinzugefügt, der Aufgabeneintrag konnte aber nicht gespeichert werden; er wird beim nächsten Start abgeglichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu a été ajouté à la bibliothèque, mais l’enregistrement de la tâche a échoué ; il sera vérifié au prochain lancement."
          }
        }
      }
    },
    "The core layer hasn’t classified this binding target": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The core layer hasn’t classified this binding target"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前核心层未分类该绑定目标"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной слой не классифицировал эту цель привязки"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kernschicht hat dieses Bindungsziel nicht klassifiziert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couche principale n’a pas classé cette cible de liaison"
          }
        }
      }
    },
    "The creator Workshop link is missing locally; looking up author info by item ID…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The creator Workshop link is missing locally; looking up author info by item ID…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地缺少作者工坊链接，正在按作品 ID 查询作者信息…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локально нет ссылки на Мастерскую автора; идёт поиск сведений об авторе по ID работы…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaler Link zum Autoren-Workshop fehlt; Autoreninfo wird über die Werk-ID gesucht…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien vers l’Atelier de l’auteur manque en local ; recherche des infos de l’auteur par ID d’œuvre…"
          }
        }
      }
    },
    "The current WEB project declares the dependency %@, which isn’t satisfied locally yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current WEB project declares the dependency %@, which isn’t satisfied locally yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 WEB 项目声明依赖包 %@，本地尚未满足该依赖。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущий WEB-проект объявляет зависимость %@, которая пока не удовлетворена локально."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle WEB-Projekt deklariert die Abhängigkeit %@, die lokal noch nicht erfüllt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet WEB actuel déclare la dépendance %@, non satisfaite localement pour l’instant."
          }
        }
      }
    },
    "The current WEB sample still has a runtime blocker, so it can’t be played directly yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current WEB sample still has a runtime blocker, so it can’t be played directly yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 WEB 样本仍存在运行阻断问题，暂时不能直接播放。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В текущем образце WEB по-прежнему есть блокирующая проблема при выполнении, поэтому прямое воспроизведение пока невозможно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim aktuellen WEB-Beispiel besteht weiterhin ein blockierendes Laufzeitproblem; die direkte Wiedergabe ist vorerst nicht möglich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’échantillon WEB actuel présente encore un blocage d’exécution ; la lecture directe n’est pas encore possible."
          }
        }
      }
    },
    "The current binding program doesn’t support this property target or execution profile.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current binding program doesn’t support this property target or execution profile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 binding program 不支持该属性目标或执行 profile。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая binding-программа не поддерживает эту цель свойства или профиль выполнения."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle Binding-Programm unterstützt dieses Eigenschaftsziel oder Ausführungsprofil nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme de liaison actuel ne prend pas en charge cette cible de propriété ni ce profil d’exécution."
          }
        }
      }
    },
    "The current download’s file may have been moved or deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current download’s file may have been moved or deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前下载项文件可能已被移动或删除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл текущей загрузки мог быть перемещён или удалён."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei des aktuellen Downloads wurde möglicherweise verschoben oder gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier du téléchargement en cours a peut-être été déplacé ou supprimé."
          }
        }
      }
    },
    "The current playback session didn’t accept the shortcut configuration; the previous choice was kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current playback session didn’t accept the shortcut configuration; the previous choice was kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前播放会话未接受快捷方式配置，已保留原选择。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущий сеанс воспроизведения не принял конфигурацию ярлыков; прежний выбор сохранён."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Wiedergabesitzung hat die Shortcut-Konfiguration nicht übernommen; die vorherige Auswahl bleibt erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session de lecture actuelle n’a pas accepté la configuration des raccourcis ; le choix précédent est conservé."
          }
        }
      }
    },
    "The download changed before it was added to the library.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download changed before it was added to the library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载内容在入库前发生变化。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое загрузки изменилось до добавления в библиотеку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download hat sich vor dem Hinzufügen zur Bibliothek geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement a changé avant d’être ajouté à la bibliothèque."
          }
        }
      }
    },
    "The download completion receipt is incomplete or doesn’t match the current task.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download completion receipt is incomplete or doesn’t match the current task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载完成凭证不完整或与当前任务不一致。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждение завершения загрузки неполное или не соответствует текущей задаче."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abschluss-Nachweis des Downloads ist unvollständig oder passt nicht zur aktuellen Aufgabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le justificatif d’achèvement du téléchargement est incomplet ou ne correspond pas à la tâche en cours."
          }
        }
      }
    },
    "The download directory contains a link or special file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download directory contains a link or special file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载目录包含链接或特殊文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каталог загрузки содержит ссылку или специальный файл."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Download-Verzeichnis enthält einen Link oder eine spezielle Datei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le répertoire de téléchargement contient un lien ou un fichier spécial."
          }
        }
      }
    },
    "The download index changed; refusing to overwrite another import transaction.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download index changed; refusing to overwrite another import transaction."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载索引已变化，拒绝覆盖其他入库事务。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индекс загрузок изменился; перезапись другой транзакции импорта отклонена."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download-Index hat sich geändert; Überschreiben einer anderen Importtransaktion abgelehnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’index des téléchargements a changé ; refus d’écraser une autre transaction d’importation."
          }
        }
      }
    },
    "The download index identity is invalid, so version reclamation is paused.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download index identity is invalid, so version reclamation is paused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载索引身份无效，已暂停版本回收。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недопустимый идентификатор индекса загрузок; освобождение версий приостановлено."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Identität des Download-Index ist ungültig; die Versionsbereinigung ist angehalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identité de l’index des téléchargements est invalide ; la récupération des versions est suspendue."
          }
        }
      }
    },
    "The download index is incomplete, so version reclamation is paused.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download index is incomplete, so version reclamation is paused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载索引不完整，已暂停版本回收。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индекс загрузок неполный; освобождение версий приостановлено."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download-Index ist unvollständig; die Versionsbereinigung ist angehalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’index des téléchargements est incomplet ; la récupération des versions est suspendue."
          }
        }
      }
    },
    "The download receipt is missing a stable staging directory identity.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download receipt is missing a stable staging directory identity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载凭证缺少稳定的暂存目录身份。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В подтверждении загрузки отсутствует стабильный идентификатор временного каталога."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Download-Nachweis fehlt eine stabile Identität des Staging-Verzeichnisses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le justificatif de téléchargement n’a pas d’identité stable de répertoire temporaire."
          }
        }
      }
    },
    "The download record changed. Reopen the list and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download record changed. Reopen the list and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载记录已变化，请重新打开列表后再删除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись загрузки изменилась. Откройте список заново и повторите удаление."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download-Eintrag hat sich geändert. Öffne die Liste erneut und versuche es noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’entrée de téléchargement a changé. Rouvrez la liste et réessayez."
          }
        }
      }
    },
    "The download record couldn’t be synced to disk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download record couldn’t be synced to disk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载记录无法同步到磁盘。"
          }
        },
        "ru": {
