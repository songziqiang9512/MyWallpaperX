          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Video ist keine lesbare Datei; der bisherige Bildschirmschoner bleibt erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo sélectionnée n’est pas un fichier lisible ; l’économiseur d’écran précédent est conservé."
          }
        }
      }
    },
    "The source data changed after import and can’t be overwritten with the old configuration. Keep the recovery file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source data changed after import and can’t be overwritten with the old configuration. Keep the recovery file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源资料已在导入后发生变化，不能用旧配置覆盖，请保留恢复文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные источника изменились после импорта; перезаписывать их старой конфигурацией нельзя. Сохраните файл восстановления."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelldaten haben sich nach dem Import geändert und dürfen nicht mit der alten Konfiguration überschrieben werden. Behalten Sie die Wiederherstellungsdatei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données source ont changé après l’import et ne peuvent pas être écrasées par l’ancienne configuration. Conservez le fichier de restauration."
          }
        }
      }
    },
    "The source entry no longer exists": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source entry no longer exists"
          }
        },
