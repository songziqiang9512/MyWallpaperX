    "After finishing on the official Pixiv page, click “Done” to return and check the account status.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After finishing on the official Pixiv page, click “Done” to return and check the account status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Pixiv 官方页面完成操作后，点击“完成”返回并检查账号状态。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершив действие на официальной странице Pixiv, нажмите «Готово», чтобы вернуться и проверить состояние аккаунта."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
