    "`%@` declares an invalid dependency ID and can’t be downloaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` deklariert eine ungültige Abhängigkeits-ID; der Download ist nicht möglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` declares an invalid dependency ID and can’t be downloaded."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` déclare un ID de dépendance non valide ; le téléchargement est impossible."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` указывает недопустимый ID зависимости; загрузка невозможна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` 声明的依赖项 ID 无效，无法下载。"
          }
        }
      }
    },
    "1  After saving the video, click “Open Screen Saver Settings”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1  Klicken Sie nach dem Sichern des Videos auf „Bildschirmschoner-Einstellungen öffnen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1  After saving the video, click “Open Screen Saver Settings”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1  Après avoir enregistré la vidéo, cliquez sur « Ouvrir les réglages de l’économiseur d’écran »."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1  После сохранения видео нажмите «Открыть настройки заставки»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1  保存视频后，点击“打开屏保设置”。"
          }
        }
      }
    },
    "2  Click “Screen Saver…” → Customize → MyWallpaperX group,\n    then select the saved video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2  Klicke auf „Bildschirmschoner…“ → „Anpassen“ → Gruppe MyWallpaperX,\n    und wähle dann das gespeicherte Video."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2  Click “Screen Saver…” → Customize → MyWallpaperX group,\n    then select the saved video."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2  Cliquez sur « Économiseur d’écran… » → « Personnaliser » → groupe MyWallpaperX,\n    puis sélectionnez la vidéo enregistrée."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2  Нажмите «Хранитель экрана…» → «Настроить» → группа MyWallpaperX,\n    затем выберите сохранённое видео."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2  点击“屏幕保护程序…” → 自定义 → MyWallpaperX 分组，\n    选择已保存的视频。"
          }
        }
      }
    },
    "2D camera zoom requires a finite 0.01…100 Slider range and an authored fallback." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der 2D-Kamerazoom erfordert einen endlichen Slider-Bereich von 0.01…100 und einen authored Fallback."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2D camera zoom requires a finite 0.01…100 Slider range and an authored fallback."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le zoom de la caméra 2D nécessite une plage de Slider finie de 0.01…100 et un fallback authored."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Масштабирование 2D-камеры требует конечного диапазона Slider 0.01…100 и authored fallback."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二维相机缩放需有限的 0.01…100 Slider 域及 authored fallback。"
          }
        }
      }
    },
