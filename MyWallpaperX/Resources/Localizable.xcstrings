    "CPU usage of this app, the playback process, and their child processes; 100% is one core (excluding system XPC services that can’t be attributed)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU usage of this app, the playback process, and their child processes; 100% is one core (excluding system XPC services that can’t be attributed)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用、播放进程及其子进程 CPU 使用率；100% 为一个核心（不含无法归属的系统 XPC 服务）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка ЦП этого приложения, процесса воспроизведения и их дочерних процессов; 100 % — одно ядро (без системных служб XPC, которые нельзя отнести)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU-Auslastung dieser App, des Wiedergabeprozesses und deren Kindprozesse; 100 % = ein Kern (ohne nicht zuordenbare System-XPC-Dienste)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation du processeur par cette app, le processus de lecture et leurs processus enfants ; 100 % correspond à un cœur (hors services XPC système non attribuables)"
          }
        }
      }
    },
