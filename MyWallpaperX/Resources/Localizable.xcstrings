    },
    "Only HTTP and HTTPS URLs are supported. Commands and other protocols aren’t." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur HTTP- und HTTPS-URLs werden unterstützt. Befehle und andere Protokolle werden nicht unterstützt."
