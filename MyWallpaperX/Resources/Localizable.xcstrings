    },
    "The source file is unavailable or the entry changed; nothing was deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source file is unavailable or the entry changed; nothing was deleted."
          }
        },
        "zh-Hans": {
