    "Video wallpapers have no author-adjustable properties. Volume, playback speed, and playback mode use the app’s playback settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video wallpapers have no author-adjustable properties. Volume, playback speed, and playback mode use the app’s playback settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频壁纸没有作者可调属性。音量、播放速度及播放方式使用应用的播放设置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У видеообоев нет настраиваемых автором свойств. Громкость, скорость и режим воспроизведения задаются в настройках воспроизведения приложения."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video-Wallpaper haben keine vom Autor anpassbaren Eigenschaften. Lautstärke, Wiedergabegeschwindigkeit und Wiedergabemodus richten sich nach den Wiedergabeeinstellungen der App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonds d’écran vidéo n’ont pas de propriétés modifiables par l’auteur. Le volume, la vitesse de lecture et le mode de lecture suivent les réglages de lecture de l’app."
          }
        }
      }
    },
