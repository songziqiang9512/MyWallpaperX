    },
    " Search applies only to loaded items.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Search applies only to loaded items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 搜索仅作用于已加载作品。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Поиск выполняется только по загруженным элементам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Die Suche gilt nur für geladene Einträge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " La recherche ne porte que sur les éléments chargés."
          }
        }
      }
    },
    " Sorting and filtering apply only to loaded items.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Sorting and filtering apply only to loaded items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 排序和筛选仅作用于已加载项目。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Сортировка и фильтры применяются только к загруженным элементам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Sortierung und Filter gelten nur für geladene Einträge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Le tri et les filtres ne s’appliquent qu’aux éléments chargés."
          }
        }
      }
    },
