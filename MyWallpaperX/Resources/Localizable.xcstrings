          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Scene 没有可调节的受支持属性，\n或属性模型尚未解析成功。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой сцены нет настраиваемых поддерживаемых свойств\nили её модель свойств не удалось разобрать."
