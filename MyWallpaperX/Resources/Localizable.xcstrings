{
  "sourceLanguage" : "en",
  "strings" : {
    "\n%lld more not shown" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n%lld weitere nicht angezeigt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n%lld more not shown"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n%lld autres non affichés"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nЕщё %lld не показано"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n另有 %lld 项未显示"
          }
        }
      }
    },
    "\nImported content and the existing list are both kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nImportierte Inhalte und die vorhandene Liste bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nImported content and the existing list are both kept."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLe contenu importé et la liste existante sont tous deux conservés."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nИмпортированное содержимое и существующий список сохраняются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n已入库内容和原列表均保留。"
          }
        }
      }
    },
    "\nOriginal wallpapers that were imported successfully remain in your library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nErfolgreich importierte originale Wallpaper bleiben in deiner Mediathek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nOriginal wallpapers that were imported successfully remain in your library."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLes fonds d’écran d’origine importés avec succès restent dans votre bibliothèque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nИсходные обои, успешно импортированные, остаются в библиотеке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n已成功导入的原始壁纸仍保留在资料库中。"
          }
        }
      }
    },
    "\nPlease try quitting again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nBitte versuche erneut zu beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nPlease try quitting again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nVeuillez réessayer de quitter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nПовторите попытку выхода."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n请重试退出。"
          }
        }
      }
    },
