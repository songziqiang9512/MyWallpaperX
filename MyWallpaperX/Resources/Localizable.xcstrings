    " Search applies only to loaded items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Die Suche gilt nur für geladene Einträge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Search applies only to loaded items."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " La recherche ne porte que sur les éléments chargés."
