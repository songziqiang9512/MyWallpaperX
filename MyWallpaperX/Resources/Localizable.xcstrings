            "state": "translated",
            "value": "Saved keys aren’t shown. Leave blank to keep the current setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的 Key 不会回显。留空不会更改当前设置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые ключи не отображаются. Оставьте поле пустым, чтобы не менять настройку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Schlüssel werden nicht angezeigt. Leer lassen, um die aktuelle Einstellung beizubehalten."
          }
        },
