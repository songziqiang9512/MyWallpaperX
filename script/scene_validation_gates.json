{
  "schema_version": 1,
  "gates": {
    "focused-tests": {
      "risk": "The changed contract regresses its nearest executable unit or Swift harness.",
      "trigger": "Every code, test, matrix, layout, or semantics change with a mapped test group.",
      "cost": "low-to-medium",
      "serialized": false,
      "retirement": "Replace only when an equivalent path-to-test selector preserves nearest-contract coverage."
    },
    "scene-all-tests": {
      "risk": "A shared Scene contract breaks a consumer outside the focused test group.",
      "trigger": "Integration or milestone validation for Scene core, playback runner, Workshop bridge, or Scene playback input changes.",
      "cost": "medium",
      "serialized": false,
      "retirement": "Retire only when dependency-aware coverage can prove the same cross-module risk with a smaller set."
    },
    "code-health": {
      "risk": "A Swift change adds a new oversized file or expands a locked legacy exception.",
      "trigger": "Swift changes when the selected build command does not already run code health.",
      "cost": "low",
      "serialized": false,
      "retirement": "Retire only if the compiler or another mandatory gate enforces the same file-size ratchet."
    },
    "build-verify": {
      "risk": "The product target no longer builds or the built app cannot launch.",
      "trigger": "Checkpoint or later validation for product, project, or bundled resource changes.",
      "cost": "medium",
      "serialized": true,
      "retirement": "Replace only with a gate that builds the same product target and verifies launchability."
    },
    "targeted-sample": {
      "risk": "Executable unit coverage passes while the affected real Scene path is visually or structurally broken.",
      "trigger": "Integration validation for Scene core, playback runner, Workshop bridge, or Scene playback input changes.",
      "cost": "medium",
      "serialized": true,
      "retirement": "Retire only when an equally representative reproducible runtime corpus becomes mandatory elsewhere."
    },
    "matrix-tier-selection": {
      "risk": "A matrix or benchmark contract change reaches milestone validation without declaring the corpus tier that must execute.",
      "trigger": "Milestone validation for matrix or benchmark contract changes without --matrix-tier.",
      "cost": "none",
      "serialized": true,
      "retirement": "Retire only when milestone tier selection is derived from an equally explicit reviewed contract."
    },
    "fixed13": {
      "risk": "A shared behavior regresses multiple stable representative samples.",
      "trigger": "Milestone validation only when targeted evidence cannot cover the documented cross-sample risk.",
      "cost": "high",
      "serialized": true,
      "retirement": "Retire when a reviewed representative suite supersedes fixed13 and preserves its regression role."
    },
    "full45": {
      "risk": "A sample-set, matrix, release, or broad shared-runtime change regresses the complete tracked corpus.",
      "trigger": "Release, milestone, sample/matrix contract change, or an unexplained risk remaining after cheaper gates.",
      "cost": "very-high",
      "serialized": true,
      "retirement": "Retire when the authoritative real-sample snapshot contract moves to a verified replacement gate."
    }
  },
  "path_groups": [
    {
      "id": "format",
      "patterns": ["MyWallpaperX/Core/SteamWorkshopScene/Format/**"],
      "keywords": ["pkg", "tex", "document", "runtime_input"]
    },
    {
      "id": "runtime",
      "patterns": ["MyWallpaperX/Core/SteamWorkshopScene/Runtime/**"],
      "keywords": ["runtime", "frame_context", "performance"]
    },
    {
      "id": "properties",
      "patterns": ["MyWallpaperX/Core/SteamWorkshopScene/Properties/**"],
      "keywords": ["property", "dynamic"]
    },
    {
      "id": "resources",
      "patterns": ["MyWallpaperX/Core/SteamWorkshopScene/Resources/**"],
      "keywords": ["resource", "texture", "video"]
    },
    {
      "id": "rendering",
      "patterns": ["MyWallpaperX/Core/SteamWorkshopScene/Rendering/**"],
      "keywords": ["rendering", "framebuffer", "image_layer", "capture"]
    },
    {
      "id": "render-graph",
      "patterns": ["MyWallpaperX/Core/SteamWorkshopScene/RenderGraph/**"],
      "keywords": ["authored_effect", "graph", "offscreen", "resolved_material", "shader"]
    },
    {
      "id": "authored-graph",
      "patterns": ["MyWallpaperX/Core/SteamWorkshopScene/RenderGraph/AuthoredGraph/**"],
      "modules": [
        "test_scene_effect_render_graph",
        "test_scene_graph_admission_compiler",
        "test_scene_resolved_material_execution_capability",
        "test_scene_resolved_material_graph_executor"
      ]
    },
    {
      "id": "layer-dependencies",
      "patterns": ["MyWallpaperX/Core/SteamWorkshopScene/RenderGraph/LayerDependencies/**"],
      "modules": [
        "test_scene_dependency_render_plan",
        "test_scene_named_render_target_pool",
        "test_scene_framebuffer_capture",
        "test_scene_utility_layers"
      ]
    },
    {
      "id": "material-program",
      "patterns": ["MyWallpaperX/Core/SteamWorkshopScene/RenderGraph/MaterialProgram/**"],
      "modules": [
        "test_scene_effect_texture_purposes",
        "test_scene_graph_texture_publication",
        "test_scene_material_program_census",
        "test_scene_resolved_material_execution_capability",
        "test_scene_resolved_material_graph_executor",
        "test_scene_resolved_material_pass_encoder",
        "test_scene_resolved_material_program_derivation",
        "test_scene_resolved_material_program_finalizer",
        "test_scene_resolved_material_template"
      ]
    },
    {
      "id": "effects",
      "patterns": ["MyWallpaperX/Core/SteamWorkshopScene/Effects/**"],
      "keywords": ["effect", "rendering", "planner"]
    },
    {
      "id": "text",
      "patterns": ["MyWallpaperX/Core/SteamWorkshopScene/Text/**"],
      "keywords": ["text"]
    },
    {
      "id": "particles",
      "patterns": ["MyWallpaperX/Core/SteamWorkshopScene/Particles/**"],
      "keywords": ["particle"]
    },
    {
      "id": "scene-debug-runner",
      "patterns": ["MyWallpaperX/App/DebugScenePlaybackRunner*.swift"],
      "modules": [
        "test_scene_frame_context",
        "test_scene_particle_audio_response",
        "test_scene_performance_telemetry",
        "test_scene_runtime_input",
        "test_scene_wallpaper_benchmark"
      ]
    },
    {
      "id": "scene-workshop-bridge",
      "patterns": ["MyWallpaperX/Modules/SteamWorkshop/Scene/**"],
      "modules": [
        "test_scene_property_live_routing",
        "test_scene_property_live_update_state",
        "test_scene_runtime_input"
      ]
    },
    {
      "id": "scene-playback-input",
      "patterns": ["MyWallpaperX/Core/Playback/*Scene*"],
      "modules": ["test_scene_audio_spectrum_input"]
    },
    {
      "id": "shader-source-set-conservation",
      "patterns": [
        "MyWallpaperX/Core/SteamWorkshopScene/RenderGraph/ShaderFrontend/**",
        "MyWallpaperX/Core/SteamWorkshopScene/RenderGraph/ShaderPreparation/**",
        "script/scene_swift_source_sets.json",
        "script/scene_swift_source_sets.py"
      ],
      "modules": ["test_scene_swift_source_sets"]
    },
    {
      "id": "documentation",
      "patterns": ["docs/**"],
      "modules": ["test_scene_semantics_coverage"]
    },
    {
      "id": "semantics",
      "patterns": [
        "AGENTS.md",
        "docs/scene/semantics/**",
        "script/scene_source_layout.json",
        "script/scene_swift_source_sets.json",
        "script/scene_swift_source_sets.py"
      ],
      "modules": [
        "test_scene_semantics_coverage",
        "test_scene_swift_source_sets"
      ]
    },
    {
      "id": "matrix",
      "patterns": [
