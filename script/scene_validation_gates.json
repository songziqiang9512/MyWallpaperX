        "script/scene_matrix_suite.py",
        "script/generate_scene_full_matrix.py",
        "script/scene_wallpaper_*matrix.json",
        "script/scene_wallpaper_benchmark.py"
      ],
      "modules": [
        "test_scene_matrix_contract",
        "test_scene_matrix_suite",
        "test_scene_wallpaper_benchmark"
      ]
    },
    {
      "id": "real-fixture",
      "patterns": [
        "script/scene_real_test_fixture.json",
        "script/scene_real_test_fixture_config.py",
        "script/scene_real_test_fixtures.py",
        "script/audit_codex_artifacts.py"
      ],
      "modules": [
        "test_scene_real_test_fixture_config",
        "test_scene_real_test_fixtures",
        "test_audit_codex_artifacts"
      ]
    },
    {
      "id": "shader-census",
      "patterns": ["script/scene_shader_preparation_census.py"],
      "modules": ["test_scene_shader_preparation_census"]
    },
    {
      "id": "material-census",
      "patterns": ["script/scene_material_program_census.py"],
      "modules": ["test_scene_material_program_census"]
    },
    {
      "id": "capability-census",
      "patterns": [
        "script/scene_capability_census*.py",
        "script/scene_capability_census_snapshot.json",
        "script/scene_capability_repair_ledger.json",
        "docs/scene/semantics/scene-corpus-capability-inventory.md"
      ],
      "modules": ["test_scene_capability_census"]
    },
    {
      "id": "validation-governance",
      "patterns": [
        "script/verify_scene_change.py",
        "script/scene_validation_gates.json",
        ".github/workflows/**"
      ],
      "modules": ["test_verify_scene_change"]
    }
  ]
}
