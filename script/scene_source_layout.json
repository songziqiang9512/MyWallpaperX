  "render_chain_authority_ratchet": {
    "completion_state": {
      "r4": "complete",
      "r5": "complete"
    },
    "rules": [
      {
        "id": "canonical-compositor-entry",
        "role": "required",
        "description": "The compositor is the only product entry into the resolved-material graph executor.",
        "pattern": "SceneResolvedMaterialGraphComposition\\.executeClaimed\\(",
        "baseline_occurrences": 1,
        "completion_target_occurrences": 1,
        "allowed_files": [
          "Rendering/SceneImageLayerCompositor.swift"
        ]
      },
      {
        "id": "canonical-runtime-entry",
        "role": "required",
        "description": "The composition helper is the only runtime call into the claimed submission coordinator.",
        "pattern": "runtime\\.executeClaimed\\(",
        "baseline_occurrences": 1,
        "completion_target_occurrences": 1,
        "allowed_files": [
          "Rendering/SceneResolvedMaterialGraphComposition.swift"
        ]
      },
      {
        "id": "legacy-product-authority",
        "role": "retirement",
        "description": "Legacy planner calls still reachable from product planning are frozen until each family migrates.",
        "pattern": "SceneEffectRuntimePlanner\\.(?:legacyPlanningDecision|plan|runtimeSummary|offscreenPassCount)\\(",
        "baseline_occurrences": 0,
        "completion_phase": "r4",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "legacy-observation-authority",
        "role": "retirement",
