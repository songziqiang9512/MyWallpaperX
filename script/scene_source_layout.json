          "SceneScriptVectorProgramModels.swift",
          "SceneScriptVectorRuntime.swift"
        ],
        "responsibility": "SceneScript VM owners, typed scalar/String/Vec and particle target projection plus callback-scoped cursor/media/property events and effect/scene/layer/object-animation bridges; excludes QuickJS core source, remaining host event API breadth, and GPU rendering consumers."
      },
      "ResolvedMaterialExecution": {
        "file_globs": [
          "SceneResolvedMaterialGraphObservationBuilder.swift",
          "SceneResolvedMaterialRuntimeBridge.swift",
          "SceneResolvedMaterialSubmissionCoordinator+Completion.swift",
          "SceneResolvedMaterialSubmissionCoordinator+Execution.swift",
          "SceneResolvedMaterialSubmissionCoordinator+FrameCommit.swift",
          "SceneResolvedMaterialSubmissionCoordinator+Lifecycle.swift",
          "SceneResolvedMaterialSubmissionCoordinator.swift"
        ],
        "responsibility": "Surface-scoped resolved-material execution lifecycle, from the runtime facade and atomic frame submission through target commit, ordered encoding, completion, rollback, epoch invalidation, and terminal graph observation; excludes scene-lifetime catalogs, generic graph telemetry, GPU executors, and Rendering consumers."
      }
    }
  },
  "forbidden_directory_names": [
    "Common",
    "Helpers",
    "Misc"
  ],
  "render_chain_authority_ratchet": {
    "completion_state": {
      "r4": "complete",
      "r5": "complete"
    },
    "rules": [
      {
        "id": "canonical-compositor-entry",
        "role": "required",
        "description": "The compositor is the only product entry into the resolved-material graph executor.",
        "pattern": "SceneResolvedMaterialGraphComposition\\.executeClaimed\\(",
        "baseline_occurrences": 1,
        "completion_target_occurrences": 1,
        "allowed_files": [
          "Rendering/SceneImageLayerCompositor.swift"
        ]
      },
      {
        "id": "canonical-runtime-entry",
        "role": "required",
        "description": "The composition helper is the only runtime call into the claimed submission coordinator.",
        "pattern": "runtime\\.executeClaimed\\(",
        "baseline_occurrences": 1,
        "completion_target_occurrences": 1,
        "allowed_files": [
          "Rendering/SceneResolvedMaterialGraphComposition.swift"
        ]
      },
      {
        "id": "legacy-product-authority",
        "role": "retirement",
        "description": "Legacy planner calls still reachable from product planning are frozen until each family migrates.",
        "pattern": "SceneEffectRuntimePlanner\\.(?:legacyPlanningDecision|plan|runtimeSummary|offscreenPassCount)\\(",
        "baseline_occurrences": 0,
        "completion_phase": "r4",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "legacy-observation-authority",
        "role": "retirement",
        "description": "The retired legacy planner must not regain diagnostic or static-disposition observation authority.",
        "pattern": "SceneEffectRuntimePlanner\\.(?:legacyPlanningDecision|plan|runtimeSummary|offscreenPassCount)\\(",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "legacy-authority-total",
        "role": "retirement",
        "description": "All external legacy planner references are frozen so a new product or observation owner cannot appear in another file.",
        "pattern": "SceneEffectRuntimePlanner\\.(?:legacyPlanningDecision|plan|runtimeSummary|offscreenPassCount)\\(",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "main-pass-writers",
        "role": "inventory",
        "description": "Direct main-pass encoder writers remain explicit while object and utility paths migrate to the frame scheduler.",
        "pattern": "(?:\\bmainPass|\\bframe\\.mainPass)\\.encoder\\(\\)",
        "baseline_occurrences": 5,
        "allowed_files": [
          "Rendering/SceneLayerColorBlendPipeline.swift",
          "Rendering/SceneMetalRenderer+Particles.swift",
          "Rendering/SceneSpotLightRuntime.swift"
        ]
      },
      {
        "id": "legacy-recovery-kinds",
        "role": "retirement",
        "description": "Product source must not reconstruct or execute partial authored graphs through Iris, X-Ray, Cursor Ripple, or Shine recovery surfaces.",
        "pattern": "(?:legacyRecovery|recoveredAdmission|terminalIrisInlineSuffix|xRayPrefix|isolatedCursorRipple|isolatedShine|irisInlineSuffix|xRayPrefixOmittedEffectPathsByLayerID|captureAfterChildrenXRayPrefix)",
        "baseline_occurrences": 0,
        "completion_phase": "r4",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "hardcoded-expected-sha",
        "role": "inventory",
        "description": "Expected SHA literals remain an explicit migration inventory and cannot increase.",
        "pattern": "\\\"[0-9a-fA-F]{64}\\\"",
        "baseline_occurrences": 5,
        "allowed_files": [
          "RenderGraph/SceneAuthoredXRayPlanner+StockIdentity.swift"
        ]
      },
      {
        "id": "numeric-workshop-selector",
        "role": "inventory",
        "description": "Numeric Workshop paths are frozen until source profiles become public typed capabilities.",
        "pattern": "workshop/[0-9]+",
        "baseline_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "named-workshop-selector",
        "role": "retirement",
        "description": "Named Workshop runtime profile dispatch is frozen until generic source contracts replace it.",
        "pattern": "workshop[0-9]+",
        "baseline_occurrences": 0,
        "completion_phase": "r4",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "retired-effect-chain-authority",
        "role": "retirement",
        "description": "The retired effect-chain owner, planner, catalog and compositor sentinel must never return to Scene product code.",
        "pattern": "(?:SceneAuthoredEffectExecutionChain|SceneAuthoredEffectChainPlanner|SceneAuthoredEffectChainAdmission|SceneAuthoredEffectExecutionCatalog|authoredEffectChain|chainsByLayerID|legacy-authored-chain-product-dispatch)",
        "baseline_occurrences": 0,
        "completion_phase": "r4",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "resolved-program-legacy-yield-dispatch",
        "role": "retirement",
        "description": "Resolved capability admission must stop consulting a legacy backend yield decision before R4 completes.",
        "pattern": "yieldsToResolvedMaterialProgram",
        "baseline_occurrences": 0,
        "completion_phase": "r4",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "legacy-light-shafts-main-pass-fallback",
        "role": "retirement",
        "description": "A quad without a resolved claim must not recover a Light Shafts plan and write the main pass after R4 completes.",
        "pattern": "authoredEffectChain\\(for:\\s*layer\\.id\\)\\?\\.singleStage\\?\\.lightShafts",
        "baseline_occurrences": 0,
        "completion_phase": "r4",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "legacy-script-source-profile-selector",
        "role": "retirement",
        "description": "Retired fixed script compilers and verified-profile dispatch must not return anywhere in product Swift; public typed provider identities are not product owners.",
        "pattern": "(?:compileVerifiedProfile\\(|SceneTextureAnimationScriptCompiler|SceneMediaThumbnailTransitionCompiler|SceneScriptAudioBarsCompiler)",
        "baseline_occurrences": 0,
        "completion_phase": "r4",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "numeric-workshop-runtime-dispatch",
        "role": "retirement",
        "description": "The retired fixed SceneScript Audio Bars runtime owner must not be reintroduced anywhere in Scene product code.",
        "pattern": "SceneScriptAudioBars",
        "baseline_occurrences": 0,
        "completion_phase": "r4",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "legacy-image-blend-product-owner",
        "role": "retirement",
        "description": "The retired independent Image Blend plan and runtime owner must not be reintroduced anywhere in Scene product code.",
        "pattern": "(?:SceneImageBlend(?:RenderPlan|Runtime|Pipeline)|requiresSourcePreparation\\(|preparedSourceTexture\\()",
        "baseline_occurrences": 0,
        "completion_phase": "r4",
        "completion_target_occurrences": 0,
        "scan_root": "MyWallpaperX",
        "allowed_files": []
      },
      {
        "id": "retired-effect-chain-render-surface",
        "role": "retirement",
        "description": "The unified executor must not regain a whole-chain renderer or standalone effect-chain entry.",
        "pattern": "(?:renderLegacyAuthoredChain|SceneStandaloneAuthoredEffectRenderer|SceneAuthoredEffectExecutionChain)",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "legacy-authored-chain-product-dispatch",
        "role": "retirement",
        "description": "The product compositor must stop invoking the legacy authored whole-chain renderer before R4 completes.",
        "pattern": "renderedTexture\\s*=\\s*renderLegacyAuthoredChain\\(",
        "baseline_occurrences": 0,
        "completion_phase": "r4",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "legacy-authored-chain-surface",
        "role": "retirement",
        "description": "R5 removes the legacy whole-chain compositor helper after its R4 product call is gone.",
        "pattern": "renderLegacyAuthoredChain\\(",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "legacy-authored-chain-render-call",
        "role": "retirement",
        "description": "R5 removes the old whole-chain renderer call surface after GraphExecutor is the only product scheduler.",
        "pattern": "SceneAuthoredEffectChainRenderer\\.render\\(",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "stage-renderer-product-call",
        "role": "retirement",
        "description": "The retired dedicated stage renderer must not re-enter product execution.",
        "pattern": "SceneEffectStageRenderer\\.render\\(",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "legacy-shader-fallback-graph",
        "role": "retirement",
        "description": "R5 removes the legacy shader fallback graph definition and call after full graph preparation owns the path.",
        "pattern": "fallbackGraph\\(",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "legacy-shader-contract-provenance",
        "role": "retirement",
        "description": "R5 removes legacyContract provenance after the fallback graph is unreachable.",
        "pattern": "\\.legacyContract",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "legacy-authored-effect-telemetry",
        "role": "retirement",
        "description": "R5 removes the old authored-effect telemetry owner after all legacy product routes are gone.",
        "pattern": "authoredEffectTelemetry",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "standalone-authored-render-call",
        "role": "retirement",
        "description": "R5 removes the unreachable standalone authored renderer call surface.",
        "pattern": "SceneStandaloneAuthoredEffectRenderer\\.render\\(",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "legacy-authored-stage-frame-plan",
        "role": "retirement",
        "description": "R5 removes the unreachable single-stage legacy frame-plan surface.",
        "pattern": "legacyAuthoredStageFramePlan\\(",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "legacy-authored-frame-batch-surface",
        "role": "retirement",
        "description": "R5 removes the old authored-chain frame-batch allocation and registration surface.",
        "pattern": "(?:prepareAndRegisterLegacyAuthoredBatch|prepareLegacyAuthoredFrameBatch|legacyAuthoredChainFramePlan)\\(",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "base-layer-inline-effect-authority",
        "role": "retirement",
        "description": "The base layer shader must remain a neutral source/dependency compositor and must not regain inline effect execution flags or parameter slots.",
        "pattern": "(?:SceneEffectFlags|effectParams[0-9]|EFFECT_(?:FOLIAGE|WATER|IRIS|SHAKE|CHROMATIC))",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "heuristic-shared-effect-texture-loading",
        "role": "retirement",
        "description": "Effect resources must be resolved by typed descriptor identity rather than shared masks or path-fragment guessing.",
        "pattern": "(?:resolveFirstTexture|resolveMaskedTexture|irisMasks|opacityMasks|waterMasks|foliageMasks|waterRippleNormals)",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "deprecated-direct-target-allocation",
        "role": "retirement",
        "description": "Render targets must be prepared and committed through the persistent graph transaction; standalone direct pool allocation APIs must not return.",
        "pattern": "func\\s+(?:textures|graphTargets|graphTargetLease)\\s*\\(",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      },
      {
        "id": "sample-specific-product-dispatch",
        "role": "retirement",
        "description": "Scene product behavior must be selected from typed authored contracts, never from sample, wallpaper or Workshop item identifiers.",
        "pattern": "(?:sampleID|sampleId|wallpaperID|wallpaperId|workshopItemID)\\s*(?:==|!=|~=)",
        "baseline_occurrences": 0,
        "completion_phase": "r5",
        "completion_target_occurrences": 0,
        "allowed_files": []
      }
    ]
  }
