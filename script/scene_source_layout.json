      },
      "ShaderPreparation": {
        "file_globs": [
          "SceneAuthoredShaderBackendCanonicalizer.swift",
          "SceneAuthoredShaderPreparation*.swift",
          "SceneGenericShader*.swift",
          "SceneShaderDirective.swift",
          "SceneShaderMacroExpansion.swift",
          "SceneShaderMalformedMetadataAdmission.swift",
          "SceneShaderPreprocessor*.swift",
          "SceneShaderVariantEnvironment*.swift",
          "SceneShaderVariantResolver*.swift"
        ],
        "responsibility": "Bounded authored-shader source preparation, including directive and macro preprocessing, variant environment and resolution, prepared-source production, signed generic compiler helper resolution/process isolation/artifact lowering, and malformed-metadata admission; excludes ShaderContract, ShaderSourceGraph, FrameInputs, ShaderFrontend, ResolvedMaterial Program validation, and GPU execution."
      }
